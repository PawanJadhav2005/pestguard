# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=postgres://pestguard_app:change-me@localhost:5432/pestguard
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated list of web origins allowed to call the API (admin portal)
CORS_ORIGINS=http://localhost:5173
# Where uploaded photos and signatures are stored
UPLOAD_DIR=./uploads

# --- Masked calling (Exotel, India). Leave blank until you sign up. ---
# While blank, the app shows "Calling is not set up" and places no call.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
